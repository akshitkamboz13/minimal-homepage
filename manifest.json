{
  "manifest_version": 3,
  "name": "Home by si4k",
  "version": "1.2.0",
  "description": "A beautiful, high-performance, and feature-rich new tab override extension for Google Chrome.",
  "author": "Akshit Kamboj (si4k)",
  "homepage_url": "https://github.com/akshitKamboj13/minimal-homepage",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "src/index.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "bookmarks",
    "offscreen",
    "search",
    "declarativeNetRequest",
    "favicon",
    "contextMenus",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://suggestqueries.google.com/*",
    "*://*.yandex.com/*",
    "*://*.yandex.ru/*",
    "*://*.bing.com/*"
  ]
}
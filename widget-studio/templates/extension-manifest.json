{
  "manifest_version": 3,
  "name": "Widget Studio User Extension",
  "version": "1.0.0",
  "description": "An extension created using Widget Studio with CLI and GUI support.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}